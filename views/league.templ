package views

import (
	"fmt"
	"github.com/Marcel2603/spikeball-league/internal/db"
)

type TeamStanding struct {
	ID           int64
	Name         string
	Wins         int
	Losses       int
	GamesPlayed  int
	PointsScored int
	PointsDiff   int
	WinRate      float64
}

templ LeagueDashboard(league db.League, teams []db.Team, matches []db.Match, standings []TeamStanding) {
	@Layout(league.Name) {
		<div x-data x-init={ fmt.Sprintf(`
			let leagues = JSON.parse(localStorage.getItem('my_leagues') || '[]');
			let exists = leagues.find(l => l.id === '%s');
			if (!exists) {
				leagues.push({ id: '%s', name: '%s', isAdmin: false });
				localStorage.setItem('my_leagues', JSON.stringify(leagues));
			}
		`, league.PublicID, league.PublicID, league.Name) } class="mb-5">

			<div class="d-flex justify-content-between align-items-center mb-4">
				<h2 class="header-title mb-0">{ league.Name }</h2>
				<a href="/" class="btn btn-outline-secondary btn-sm">Home</a>
			</div>

			<div class="row g-4">
				<div class="col-lg-8">
					<div id="standings-container">
						<div class="card shadow-sm border-0 mb-4">
							<div class="card-header bg-white border-bottom-0 pt-4 pb-0">
								<h5 class="card-title header-title">Leaderboard</h5>
							</div>
							<div class="card-body p-4">
								if len(standings) == 0 {
									<p class="text-muted small text-center my-4">No data available yet. Ask the admin to add teams and start logging matches.</p>
								} else {
									<div class="table-responsive">
										<table class="table table-hover align-middle text-center">
											<thead>
												<tr>
													<th class="text-start">Rank</th>
													<th class="text-start">Team</th>
													<th>Played</th>
													<th>Wins</th>
													<th>Losses</th>
													<th>Win %</th>
													<th>Pts Diff</th>
												</tr>
											</thead>
											<tbody>
												for i, s := range standings {
													<tr>
														<td class="text-start fw-bold text-muted">#{ fmt.Sprint(i + 1) }</td>
														<td class="text-start fw-bold">{ s.Name }</td>
														<td>{ fmt.Sprint(s.GamesPlayed) }</td>
														<td class="text-success fw-bold">{ fmt.Sprint(s.Wins) }</td>
														<td class="text-danger fw-bold">{ fmt.Sprint(s.Losses) }</td>
														<td>{ fmt.Sprintf("%.1f%%", s.WinRate) }</td>
														<td>
															if s.PointsDiff > 0 {
																<span class="text-success">+{ fmt.Sprint(s.PointsDiff) }</span>
															} else if s.PointsDiff < 0 {
																<span class="text-danger">{ fmt.Sprint(s.PointsDiff) }</span>
															} else {
																<span class="text-muted">0</span>
															}
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
							</div>
						</div>
					</div>

					if len(teams) >= 2 {
						@MatchForm(teams, league.PublicID)
					} else {
						<div class="alert alert-info shadow-sm border-0">
							<div class="fw-bold mb-1">Not enough teams</div>
							<span class="small">At least 2 teams are required to log a match. The admin must create more teams.</span>
						</div>
					}
				</div>

				<div class="col-lg-4">
					<div class="card shadow-sm border-0 h-100">
						<div class="card-header bg-white border-bottom-0 pt-4 pb-0">
							<h5 class="card-title header-title">Match History</h5>
						</div>
						<div class="card-body p-4">
							if len(matches) == 0 {
								<p class="text-muted small text-center my-4">No matches logged yet.</p>
							} else {
								<div class="d-flex flex-column gap-3">
									for _, m := range matches {
										<div class="p-3 border rounded bg-light">
											<div class="text-muted small mb-2 text-center border-bottom pb-2">
												{ formatTime(m.CreatedAt) }
											</div>
											<div class="d-flex justify-content-between align-items-center">
												<div class="text-start" style="width: 40%">
													<div class="small fw-medium text-truncate">{ getTeamName(teams, m.Team1ID) }</div>
												</div>
												<div class="text-center fw-bold fs-5 px-2 text-primary" style="width: 20%">
													{ fmt.Sprint(m.Team1Score) } - { fmt.Sprint(m.Team2Score) }
												</div>
												<div class="text-end" style="width: 40%">
													<div class="small fw-medium text-truncate">{ getTeamName(teams, m.Team2ID) }</div>
												</div>
											</div>
										</div>
									}
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
