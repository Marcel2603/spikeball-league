package views

import (
	"fmt"
	"github.com/Marcel2603/spikeball-league/internal/db"
)

templ MatchForm(teams []db.Team, leaguePublicID string) {
	<div class="card shadow-sm border-0 mb-4" id="match-form-container">
		<div class="card-body p-4">
			<h5 class="card-title header-title mb-4">Log a Match</h5>
			<form hx-post={ "/league/" + leaguePublicID + "/matches" } hx-target="body">
				<div class="row g-4 mb-4">
					<!-- Team 1 -->
					<div class="col-md-5">
						<div class="p-3 bg-light rounded border">
							<h6 class="fw-bold mb-3 text-primary">Team 1</h6>
							<div class="mb-3">
								<label class="form-label small fw-medium">Select Team</label>
								<select name="team1_id" class="form-select" required>
									<option value="">Select team...</option>
									for _, t := range teams {
										<option value={ fmt.Sprint(t.ID) }>{ t.Name }</option>
									}
								</select>
							</div>
							<div>
								<label class="form-label small fw-medium">Score</label>
								<input type="number" name="team1_score" class="form-control form-control-lg text-center" min="0" required placeholder="0"/>
							</div>
						</div>
					</div>

					<!-- VS divider -->
					<div class="col-md-2 d-flex align-items-center justify-content-center">
						<div class="text-muted fw-bold">VS</div>
					</div>

					<!-- Team 2 -->
					<div class="col-md-5">
						<div class="p-3 bg-light rounded border">
							<h6 class="fw-bold mb-3 text-primary">Team 2</h6>
							<div class="mb-3">
								<label class="form-label small fw-medium">Select Team</label>
								<select name="team2_id" class="form-select" required>
									<option value="">Select team...</option>
									for _, t := range teams {
										<option value={ fmt.Sprint(t.ID) }>{ t.Name }</option>
									}
								</select>
							</div>
							<div>
								<label class="form-label small fw-medium">Score</label>
								<input type="number" name="team2_score" class="form-control form-control-lg text-center" min="0" required placeholder="0"/>
							</div>
						</div>
					</div>
				</div>
				<div class="text-end">
					<button type="submit" class="btn btn-primary px-4">Submit Match</button>
				</div>
			</form>
		</div>
	</div>
}
